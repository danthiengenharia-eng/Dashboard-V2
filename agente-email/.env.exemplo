# Copie para .env (fica fora do git). Nunca compartilhe este arquivo.
IMAP_SERVIDOR=mail.SEU-DOMINIO.com.br
IMAP_USUARIO=contratocaixa@SEU-DOMINIO.com.br
IMAP_SENHA=
GOOGLE_SA_JSON=C:\agente\google-sa.json
CONFIG_DASHBOARD=G:\Meu Drive\dashboard-cef-config.json
PASTA_LAUDOS=G:\Meu Drive\Danthi\Caixa Economica Federal\Laudos
# Avisos no iPhone (app ntfy): escolha um nome de tópico longo e difícil de adivinhar
NTFY_SERVIDOR=https://ntfy.sh
NTFY_TOPICO=
NTFY_TOKEN=
# Só e-mails recebidos a partir deste dia são processados (protege os e-mails antigos da caixa). Formato AAAA-MM-DD
DESDE=
# Pasta onde o agente do SIOPI recebe os pedidos: a pasta Laudos do DRIVE (a mesma que o agente do SIOPI vigia).
# Se vazio, usa PASTA_LAUDOS. No teste com pasta local, aponte aqui para a Laudos do Drive.
SIOPI_PASTA=
